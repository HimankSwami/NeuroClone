# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Miniconda / Conda
.conda/
conda-bld/

# Environment — NEVER commit API keys
.env

# Audio files (generated at runtime)
*.wav
*.mp3
voice/temp.wav
voice/output.wav
voice/playing.flag

# Large model files (not for git)
*.gguf
*.bin
*.pth
*.index
models/

# 3D avatar files (too large for git — store separately)
*.glb
*.vrm
body/static/*.glb
body/static/*.vrm

# RAG / ChromaDB (rebuilt at runtime)
data/chroma_db/

# Knowledge base docs (optional — uncomment to ignore)
# knowledge/

# OS / editor junk
.DS_Store
.vscode/
.idea/

# Misc
bool:
